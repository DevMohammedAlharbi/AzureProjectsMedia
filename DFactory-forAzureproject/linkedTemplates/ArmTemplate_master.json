{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFactory-forAzureproject"
		},
		"AzureDataLakeStorageFor_Linked_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageFor_Linked'"
		},
		"AzureSQLFOR_Linked_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQLFOR_Linked'"
		},
		"AzureDataLakeStorageFor_Linked_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storge4azureproject.dfs.core.windows.net/"
		},
		"AzureSQLFOR_Linked_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server-for-azureproject.database.windows.net"
		},
		"AzureSQLFOR_Linked_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureProjectMoH"
		},
		"AzureSQLFOR_Linked_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-server"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DFactory-forAzureproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorageFor_Linked_accountKey": {
						"value": "[parameters('AzureDataLakeStorageFor_Linked_accountKey')]"
					},
					"AzureSQLFOR_Linked_password": {
						"value": "[parameters('AzureSQLFOR_Linked_password')]"
					},
					"AzureDataLakeStorageFor_Linked_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageFor_Linked_properties_typeProperties_url')]"
					},
					"AzureSQLFOR_Linked_properties_typeProperties_server": {
						"value": "[parameters('AzureSQLFOR_Linked_properties_typeProperties_server')]"
					},
					"AzureSQLFOR_Linked_properties_typeProperties_database": {
						"value": "[parameters('AzureSQLFOR_Linked_properties_typeProperties_database')]"
					},
					"AzureSQLFOR_Linked_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQLFOR_Linked_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}